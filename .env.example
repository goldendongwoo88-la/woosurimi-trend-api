# 이 파일을 복사해서 .env로 저장하고, 실제 발급받은 값으로 채우세요.
# cp .env.example .env

# --- NAVER API HUB (네이버 클라우드 플랫폼) — 블로그·뉴스 검색용 ---
# 예전에는 developers.naver.com에서 "검색" API를 바로 발급받았지만,
# 지금은 NAVER API HUB로 이전되어 아래 이름으로 바뀌었습니다.
# ⚠️ "뉴스" 검색(엔터 뉴스 기능)을 쓰려면 NAVER API HUB 콘솔에서 "뉴스" API도
# 추가로 이용 신청해야 합니다 — "블로그"만 신청했다면 /api/entertainment/news가
# 에러를 낼 수 있어요. 같은 애플리케이션에 추가되면 아래 값 그대로 재사용하면 됩니다.
NAVER_APIHUB_KEY_ID=
NAVER_APIHUB_KEY_SECRET=

# --- 네이버 검색광고 API (searchad.naver.com) — 키워드도구용 ---
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# --- AI 성우 목소리(TTS) — 숏폼 자동 제작의 나레이션 기능용, 필요한 것만 골라서 채우세요 ---
# 하나도 안 채워도 서버는 정상 작동합니다 — 그냥 나레이션 없이(자막만) 영상이 만들어져요.
# 1) 네이버 CLOVA Voice (NCP 콘솔에서 발급) — 유료
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
# 2) 타입캐스트 Typecast (typecast.ai 개발자센터에서 발급) — 유료
TYPECAST_API_KEY=
TYPECAST_ACTOR_ID=
# 3) ElevenLabs (elevenlabs.io 계정에서 발급) — 유료
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 4) Microsoft Azure Speech (Azure 포털에서 발급) — 유료
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# 5) Voicebox (voicebox.sh, 로컬 무료 오픈소스 — 이 컴퓨터에 Voicebox 앱을 설치하고
#    실행 중이어야 동작. 내 목소리를 복제해서 무료로 나레이션을 만들 때 씀)
#    회사 정책(CLAUDE.md, 2026-08-31): 쇼츠 나레이션은 "골든 보이스" 또는 "차수리미 보이스"
#    프로필만 사용(둘 다 Voicebox 앱에 이미 생성돼 있음). Voicebox 실행 중일 때
#    GET http://127.0.0.1:17493/profiles 로 두 프로필의 실제 ID를 확인해서 아래에 넣으세요.
VOICEBOX_PROFILE_ID=
# VOICEBOX_URL=http://127.0.0.1:17493   # 기본값. 다른 컴퓨터에서 돌리면 그 주소로 변경
# VOICEBOX_ENGINE=qwen_custom_voice     # 기본값. chatterbox 등 다른 엔진으로 바꿀 수 있음

# --- Pexels API — "AI 카드뉴스 생성"의 배경 사진 검색용 (pexels.com/api에서 무료 발급) ---
# 안 채워도 서버는 정상 작동합니다 — 그냥 스톡 사진 검색 탭이 안 보이고, 직접 업로드 또는
# 스타일 그라디언트 배경만 쓸 수 있어요.
PEXELS_API_KEY=

# --- Claude API — "AI 자동화 글쓰기" 초안의 실제 문장 생성용 ---
# console.anthropic.com에서 발급받은 API 키를 넣으세요. 안 채워도 서버는 정상 작동하고,
# 대신 실제 문장 없이 "빈칸(✏️)만 채우면 되는 글쓰기 틀"로 초안이 만들어집니다.
ANTHROPIC_API_KEY=
# (선택) 다른 Claude 모델을 쓰고 싶을 때만 바꾸세요. 비워두면 기본값을 씁니다.
ANTHROPIC_MODEL=

# --- 선택 ---
PORT=3000
REFRESH_CRON=*/10 * * * *
OPPORTUNITY_TTL_MS=600000
